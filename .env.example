# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=233557843743

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only

# Paystack (use TEST keys until launch)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx                   # server only

# Resend (transactional email)
RESEND_API_KEY=re_xxx                             # server only
EMAIL_FROM="GeoJoy Ventures <orders@your-domain.com>"
OWNER_ALERT_EMAIL=owner@your-domain.com
